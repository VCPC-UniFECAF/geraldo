<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="geraldo">

  <xacro:property name="body_mass" value="25.0"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="1.5"/>
  <xacro:property name="wheel_x" value="0.10"/>
  <xacro:property name="wheel_y" value="0.225"/>
  <!-- rodízio: pino vertical em (-0,25; 0; 0,09) e roda 1,5 cm atrás dele (trail), encostada no chão -->
  <xacro:property name="caster_pivot_x" value="-0.25"/>
  <xacro:property name="caster_pivot_z" value="0.09"/>
  <xacro:property name="caster_trail" value="0.015"/>
  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_width" value="0.022"/>
  <xacro:property name="pi_2" value="1.5707963"/>

  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://geraldo_description/meshes/geraldo_body.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.145"/>
      <geometry><box size="0.70 0.50 0.20"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.05 0 0.36"/>
      <geometry><box size="0.58 0.48 0.21"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.22"/>
      <mass value="${body_mass}"/>
      <inertia ixx="0.943" ixy="0" ixz="0" iyy="1.443" iyz="0" izz="1.542"/>
    </inertial>
  </link>

  <!-- as malhas saem do Blender em coordenadas do base_link; o visual desfaz o deslocamento da junta da roda -->
  <xacro:macro name="wheel" params="side y mesh">
    <link name="wheel_${side}_link">
      <visual>
        <origin xyz="${-wheel_x} ${-y} ${-wheel_radius}"/>
        <geometry><mesh filename="package://geraldo_description/meshes/${mesh}"/></geometry>
      </visual>
      <collision>
        <origin rpy="${pi_2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin rpy="${pi_2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.00395" ixy="0" ixz="0" iyy="0.00395" iyz="0" izz="0.0075"/>
      </inertial>
    </link>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="${wheel_x} ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="wheel_${side}_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_y}" mesh="roda_esq.obj"/>
  <xacro:wheel side="right" y="${-wheel_y}" mesh="roda_dir.obj"/>

  <!-- rodízio articulado: o garfo gira em torno do pino (Z) e a roda pequena rola em torno do próprio eixo (Y) -->
  <link name="caster_swivel_link">
    <visual>
      <origin xyz="${-caster_pivot_x} 0 ${-caster_pivot_z}"/>
      <geometry><mesh filename="package://geraldo_description/meshes/rodizio_garfo.obj"/></geometry>
    </visual>
    <inertial>
      <origin xyz="-0.007 0 -0.019"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_swivel_link"/>
    <origin xyz="${caster_pivot_x} 0 ${caster_pivot_z}"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="caster_wheel_link">
    <visual>
      <origin xyz="${-(caster_pivot_x - caster_trail)} 0 ${-caster_radius}"/>
      <geometry><mesh filename="package://geraldo_description/meshes/rodizio_roda.obj"/></geometry>
    </visual>
    <collision>
      <origin rpy="${pi_2} 0 0"/>
      <geometry><cylinder radius="${caster_radius}" length="${caster_width}"/></geometry>
    </collision>
    <inertial>
      <origin rpy="${pi_2} 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00024"/>
    </inertial>
  </link>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_swivel_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${-caster_trail} 0 ${caster_radius - caster_pivot_z}"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>
  <gazebo reference="caster_wheel_link">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <link name="lidar_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00004"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.275 0 0.259"/>
  </joint>

  <!-- O baú bloqueia a visão para trás do LiDAR (fica 3,5 cm atrás dele): o campo de visão simulado é de ~172 graus.
       A traseira é coberta pelos sensores de alcance a 135 graus (semana 2). -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-1.5</min_angle>
            <max_angle>1.5</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <max_linear_velocity>1.0</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
    </plugin>
  </gazebo>
</robot>
