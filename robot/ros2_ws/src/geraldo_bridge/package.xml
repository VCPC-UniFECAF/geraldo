<?xml version="1.0"?>
<package format="3">
  <name>geraldo_bridge</name>
  <version>0.1.0</version>
  <description>Ponte entre o ROS 2 e o aplicativo local: HTTP e WebSocket só em 127.0.0.1, só com os tópicos que o app usa.</description>
  <maintainer email="geraldo@example.com">Samuel</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
